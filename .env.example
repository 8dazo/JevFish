# ===== System Two: OpenAI-compatible generative model =====
# OpenRouter example used by the provider-backed JevFish benchmarks.
# Any compatible provider/model can be substituted.
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=meta/muse-spark-1.3-contributor

# ===== System One: TypeSafe Jev =====
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_DEFAULT_MODEL=jev-latest

# llm = untouched OASIS LLMAction baseline
# hybrid = Jev plans behavior; System Two is used only for text/uncertainty
# jev = structured Jev stress test with no generative text fallback
JEVFISH_DECISION_ENGINE=hybrid

# multi = action-bundle policy (default/recommended)
# single = preserved V0.1 one-action router for ablations/compatibility
JEVFISH_POLICY_MODE=multi

# oasis_refresh = use each agent's personalized OASIS recommendation feed
# recent = legacy approximation using globally recent SQLite posts
JEVFISH_OBSERVATION_MODE=oasis_refresh

# Base minimum probability/confidence for cheap behavioral gates.
JEVFISH_CONFIDENCE_THRESHOLD=0.58
# Text-generating actions (quote/comment/create_post) are intentionally stricter.
JEVFISH_GENERATIVE_CONFIDENCE_THRESHOLD=0.72
# Target selection can use a separate confidence floor.
JEVFISH_TARGET_CONFIDENCE_THRESHOLD=0.58

# Optional per-action overrides. Leave unset to use adaptive defaults.
# JEVFISH_LIKE_CONFIDENCE_THRESHOLD=0.58
# JEVFISH_FOLLOW_CONFIDENCE_THRESHOLD=0.58
# JEVFISH_REPOST_CONFIDENCE_THRESHOLD=0.60
# JEVFISH_DISLIKE_CONFIDENCE_THRESHOLD=0.60
# JEVFISH_QUOTE_CONFIDENCE_THRESHOLD=0.72
# JEVFISH_CREATE_POST_CONFIDENCE_THRESHOLD=0.72
# JEVFISH_COMMENT_CONFIDENCE_THRESHOLD=0.72

# Maximum number of posts exposed to Jev per decision.
JEVFISH_MAX_CONTEXT_POSTS=12
# Maximum actions one agent may execute in one OASIS tick.
JEVFISH_MAX_ACTIONS_PER_AGENT=3
# Maximum text-requiring actions materialized by System Two per agent/tick.
JEVFISH_MAX_SYSTEM_TWO_ACTIONS=1

# Probability sampling is useful for many-world rollouts.
# Disable it for controlled A/B benchmark runs and deterministic demos.
JEVFISH_SAMPLE_PROBABILITIES=false

# Best-effort local/OASIS reproducibility. Remote model providers may remain
# nondeterministic, so public benchmark claims should use repeated trials.
JEVFISH_SEED=42

# ===== Graph memory =====
# Required by the full document -> graph -> simulation workflow.
ZEP_API_KEY=your_zep_api_key_here

# ===== Production demo =====
# Local development can leave APP_ENV unset. Production requires a strong secret.
APP_ENV=development
SECRET_KEY=replace_with_at_least_32_random_characters_for_production
FLASK_DEBUG=false

# Only needed when the frontend is hosted on a different origin. The production
# Docker image serves frontend + API from one origin and does not need CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Keep these low for a public demo so strangers cannot exhaust provider credits.
MAX_CONCURRENT_SIMULATIONS=2
DEMO_STARTS_PER_MINUTE=4
DEMO_MUTATIONS_PER_MINUTE=20
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=600

# ===== Optional secondary/boost LLM =====
# Remove these variables entirely if you do not use a separate boost model.
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
