# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== JevFish / TypeSafe System One =====
# Get early-access credentials from TypeSafe AI.
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_DEFAULT_MODEL=jev-latest
# llm = original MiroFish behavior, hybrid = Jev + LLM fallback, jev = Jev-only structured actions
JEVFISH_DECISION_ENGINE=hybrid
# Below this confidence, hybrid mode delegates the decision to the generative LLM.
JEVFISH_CONFIDENCE_THRESHOLD=0.58
# Number of recent feed posts exposed to Jev per decision.
JEVFISH_MAX_CONTEXT_POSTS=12
# Sample calibrated probabilities instead of always taking argmax, preserving stochastic simulations.
JEVFISH_SAMPLE_PROBABILITIES=true

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
