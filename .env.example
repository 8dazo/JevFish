# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== JevFish / TypeSafe System One =====
# Get early-access credentials from TypeSafe AI.
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_DEFAULT_MODEL=jev-latest

# llm = exact OASIS LLMAction baseline
# hybrid = Jev plans behavior; System Two is used only for text/uncertainty
# jev = structured Jev stress test with no generative text fallback
JEVFISH_DECISION_ENGINE=hybrid

# multi = V0.2+ action bundle policy (default/recommended)
# single = preserved V0.1 one-action router for ablations/compatibility
JEVFISH_POLICY_MODE=multi

# oasis_refresh = use each agent's personalized OASIS recommendation feed.
# recent = legacy V0.2 approximation using globally recent SQLite posts.
JEVFISH_OBSERVATION_MODE=oasis_refresh

# Base minimum probability/confidence for cheap behavioral gates.
JEVFISH_CONFIDENCE_THRESHOLD=0.58
# Text-generating actions (quote/comment/create_post) are intentionally stricter.
JEVFISH_GENERATIVE_CONFIDENCE_THRESHOLD=0.72
# Target selection can use a separate confidence floor.
JEVFISH_TARGET_CONFIDENCE_THRESHOLD=0.58
# Optional per-action overrides. Leave unset to use adaptive defaults.
# JEVFISH_LIKE_CONFIDENCE_THRESHOLD=0.58
# JEVFISH_FOLLOW_CONFIDENCE_THRESHOLD=0.58
# JEVFISH_REPOST_CONFIDENCE_THRESHOLD=0.60
# JEVFISH_DISLIKE_CONFIDENCE_THRESHOLD=0.60
# JEVFISH_QUOTE_CONFIDENCE_THRESHOLD=0.72
# JEVFISH_CREATE_POST_CONFIDENCE_THRESHOLD=0.72
# JEVFISH_COMMENT_CONFIDENCE_THRESHOLD=0.72

# Maximum number of posts exposed to Jev per decision.
JEVFISH_MAX_CONTEXT_POSTS=12
# Maximum actions one agent may execute in a single OASIS tick.
JEVFISH_MAX_ACTIONS_PER_AGENT=3
# Maximum text-requiring actions materialized by System Two per agent/tick.
JEVFISH_MAX_SYSTEM_TWO_ACTIONS=1
# Sample calibrated probabilities instead of always taking argmax.
# Use false for deterministic A/B benchmarks; true for stochastic rollouts.
JEVFISH_SAMPLE_PROBABILITIES=true

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
